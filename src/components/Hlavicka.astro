---
// Jedno menu, stejné na každé stránce. Žádné kotvy na sekce, žádné
// tlačítko navíc — jen přepínání mezi verzemi a odkaz na živý web.
const base = import.meta.env.BASE_URL;
const { poukazyUrl = `${base}darkove-poukazy/` } = Astro.props;

const cesta = Astro.url.pathname;
const jeAktivni = (cast) => cast === '' ? (cesta === base || cesta === base.slice(0, -1)) : cesta.includes(`/${cast}/`);

const polozky = [
  { href: base, text: 'Světlá', aktivni: jeAktivni('') },
  { href: `${base}tmava/`, text: 'Tmavá', aktivni: jeAktivni('tmava') },
  { href: poukazyUrl, text: 'Poukazy', aktivni: jeAktivni('darkove-poukazy') },
];
---
<header class="hlavicka">
  <div class="hlavicka__obal">
    <a class="znacka" href={base}>
      <img src={`${base}obrazky/logo-152.webp`} alt="" width="33" height="38" decoding="async">
      <span class="znacka__text">Kulturní Barbershop</span>
    </a>

    <nav aria-label="Hlavní nabídka">
      <ul class="menu">
        {polozky.map((p) => (
          <li><a href={p.href} aria-current={p.aktivni ? 'page' : undefined}>{p.text}</a></li>
        ))}
        <li><a href="https://www.kulturnibarbershop.cz" target="_blank" rel="noopener">Old</a></li>
      </ul>
    </nav>
  </div>
</header>
