---
import Hlavicka from '../components/Hlavicka.astro';
import Paticka from '../components/Paticka.astro';
import Souhlas from '../components/Souhlas.astro';

const base = import.meta.env.BASE_URL;
const {
  title,
  description = 'Pánské kadeřnictví a holičství v centru Kolína.',
  jeUvodni = false,
  poukazyUrl,
  ukazatVyzvu = true,
  bodyTrida = '',
  extraCss = '',
  zaklad,
  ukazatPaticku = true,
  ukazatSouhlas = true,
} = Astro.props;
---
<!doctype html>
<html lang="cs">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href={`${base}style.css`}>
  <link rel="stylesheet" href={`${base}poukazy.css`}>
  <link rel="stylesheet" href={`${base}mockup.css`}>
  {extraCss && <link rel="stylesheet" href={`${base}${extraCss}`}>}
  <link rel="icon" href={`${base}favicon-32x32.png`} sizes="32x32">
  <link rel="icon" href={`${base}favicon-192x192.png`} sizes="192x192">
  <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
</head>
<body class={bodyTrida}>
  <a class="ctecka" href="#obsah">Přeskočit na obsah</a>
  <Hlavicka poukazyUrl={poukazyUrl} />
  <slot />
  {ukazatPaticku && <Paticka jeUvodni={jeUvodni} ukazatVyzvu={ukazatVyzvu} zaklad={zaklad} />}
  {ukazatSouhlas && <Souhlas />}
</body>
</html>
